# Copy to .env and adjust. Never commit the real .env.
# Docker Compose reads this file for variable substitution.

NODE_ENV=production
LOG_LEVEL=info

# Public entrypoint (Caddy). ":80" = plain HTTP on PUBLIC_HTTP_PORT.
# In production set SITE_ADDRESS to your domain and publish 443 for automatic TLS.
SITE_ADDRESS=:80
PUBLIC_HTTP_PORT=8080

POSTGRES_USER=leadora
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=leadora

# Used only when running apps on the host (pnpm dev) against docker-compose.dev.yml.
# Inside Docker the URLs are composed from the values above.
DATABASE_URL=postgres://leadora:change-me-postgres@localhost:5432/leadora
VALKEY_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Auth
# Origins allowed to send state-changing requests (comma-separated). Must match the URL users open.
APP_ORIGINS=http://localhost:8080,http://localhost:3000
# false: only the very first organization can self-register (first-run setup). true: open SaaS signup.
ALLOW_SIGNUP=false
# Secure cookies need HTTPS. Browsers treat http://localhost as secure; set false only for plain-HTTP LAN testing.
COOKIE_SECURE=true
SESSION_TTL_HOURS=168

# Encrypts channel/provider secrets at rest. Generate like JWT_SECRET. To change it, follow docs/RUNBOOK.md §6.1
# (re-encrypts stored secrets); editing it here alone makes them unreadable.
DATA_ENCRYPTION_KEY=change-me-to-another-long-random-secret-32-chars-min
# Outbound email. Local dev uses the Mailpit container (UI at http://localhost:8025).
SMTP_URL=smtp://mailpit:1025
PUBLIC_BASE_URL=http://localhost:8080

# AI (Phase 3+). Leave empty until configured; core CRM must work without it.
OPENAI_API_KEY=

# File storage for knowledge-base uploads. local (Docker volume) | s3 (any S3-compatible service)
STORAGE_DRIVER=local
# Only used outside Docker with STORAGE_DRIVER=local; Compose mounts a volume at /data/uploads.
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
KB_MAX_FILE_MB=20

# Platform kill switches (spec §136)
ENABLE_AI=false
ENABLE_KNOWLEDGE_BASE=false
ENABLE_AUTOMATION=false
ENABLE_WHATSAPP=false
ENABLE_EMAIL=false
ENABLE_ADVANCED_ANALYTICS=false
ENABLE_AI_AUTO_REPLY=false

# Optional malware scanning of uploads (start with: docker compose --profile clamav up -d)
CLAMAV_HOST=
CLAMAV_PORT=3310
# Requests per minute per signed-in user / API key (spec §69)
RATE_LIMIT_API_PER_MIN=1200
RATE_LIMIT_AI_PER_MIN=30
# Bearer token for the internal /metrics endpoints (api:3001/metrics, worker:3002/metrics). Empty = no token.
METRICS_TOKEN=
# Error tracking: a Sentry or self-hosted GlitchTip DSN (https://<key>@<host>/<project>). Empty = off.
# Reports carry ids (request, organization, user) and the error, never request bodies or personal data.
ERROR_TRACKING_DSN=
# Release name on error reports, e.g. the git commit.
APP_RELEASE=
# Backups (COMPOSE_PROFILES=backup). Keep the passphrase somewhere other than this server: without it backups cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24

# Optional demo data (`pnpm db:seed`, never in production): a separate "Demo Traders" organization.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_AGENT_EMAIL=
# SEED_AGENT_PASSWORD=
